# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=30

# GitHub Integration (Optional - increases rate limits if provided)
GITHUB_TOKEN=

# iNSIGHTS Service Configuration
